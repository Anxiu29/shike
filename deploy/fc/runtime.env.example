# 只复制到云端环境变量；不把真实值提交 Git。
NODE_ENV=production
HOST=0.0.0.0
PORT=9000
APP_PUBLIC_MODE=true
AI_PROVIDER=qwen
AI_MODE=live
QWEN_MODEL=qwen3.7-flash
DASHSCOPE_API_KEY=
APP_ACCESS_CODE=
APP_TOKEN_SECRET=
APP_ALLOWED_ORIGINS=https://localhost
# 使用网页版时再加自己的精确 HTTPS 来源，或配置 PUBLIC_ORIGIN。
# PUBLIC_ORIGIN=https://shike.example.com
AI_TIMEOUT_MS=45000
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
AI_CONCURRENCY=1
QUOTA_STORE=oss
OSS_QUOTA_REGION=oss-cn-beijing
OSS_QUOTA_BUCKET=replace-with-your-private-bucket
# 云端专用、最小权限的 RAM 凭证；也支持官方凭证链提供的临时凭证。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
# 可刷新凭证服务由管理员配置时，可改用 ALIBABA_CLOUD_CREDENTIALS_URI。
