# 仅由服务端读取，严禁使用 VITE_ 前缀保存密钥。
AI_PROVIDER=gemini
AI_MODE=auto
GEMINI_API_KEY=
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
# DeepSeek：AI_PROVIDER=deepseek，固定视觉型号deepseek-flash，按量计费。
# 新免费视觉选项：AI_PROVIDER=siliconflow 或 openrouter；实际额度以平台为准。
# 新配置默认NVIDIA免费视觉；同一Key也可手动选Dots3预览。
# 白名单：nvidia/nemotron-3.5-super-vl:free / dots-studio/dots-3-note-preview:free
# OpenRouter的Google／Gemma型号已移除；旧环境配置需改为上述可用型号。
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# AI_PROVIDER=qwen 时生效；北京区通用 Key，不能与其他地域混用。
# 白名单：qwen3.7-flash / qwen3.8-flash / qwen3.7-plus / qwen3-vl-plus
QWEN_MODEL=qwen3.7-flash

# 智谱同一标准API Key可选五款：glm-4.1v-thinking-flash / glm-4.6v-flash / glm-4.6v-flashx / glm-5.3-flash / glm-5.3-flashx。
# 有5.3专属资源包时，GLM_MODEL可改为对应的glm-5.3-flash或glm-5.3-flashx；先核对有效期和账单抵扣。
# FlashX为付费视觉型号，需在智谱充值模型标准API余额，或有适用的可抵扣额度。
# 免费备用保持4.1V；选用付费型号时改为GLM_MODEL=glm-4.6v-flashx。
# 不设置时保留旧默认glm-4.6v-flash；GLM_MODEL只控制服务端默认选择。
GLM_MODEL=glm-4.1v-thinking-flash
PORT=3001
HOST=127.0.0.1
AI_TIMEOUT_MS=45000
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=100
AI_CONCURRENCY=1
APP_PUBLIC_MODE=false
APP_ACCESS_CODE=
APP_TOKEN_SECRET=
APP_ALLOWED_ORIGINS=https://localhost
QUOTA_STORE=memory
# 公网必须启用 APP_PUBLIC_MODE=true、访问保护及 OSS 持久化限额。
# OSS_QUOTA_BUCKET=你的私有计数Bucket
# OSS_QUOTA_REGION=oss-cn-beijing
# 完整云端配置见 deploy/fc/runtime.env.example。
# 局域网手机测试或 HTTPS 反向代理时填写页面的精确来源，勿加路径。
# PUBLIC_ORIGIN=https://shike.example.com

# 当前默认停用自建云端连接，以上部署变量保留供后续使用。
# 非密钥开关 VITE_ENABLE_SERVICE_CONNECTION=true 仅供未来恢复功能；
# 需要时写在 packages/web/.env.local 并重新构建，切勿将模型Key写入任何VITE_变量。
# Open Food Facts 只读查询无需API Key。
